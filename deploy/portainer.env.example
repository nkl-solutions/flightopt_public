FLIGHTOPT_BASIC_USER=devnk
FLIGHTOPT_BASIC_PASSWORD=change-me-in-portainer
OPENAI_API_KEY=
SERPAPI_KEY=
SERPAPI_MONTHLY_CAP=
# Meldekanal der Fehltarif-Jagd: eine Discord-Webhook-URL, kein Bot-Konto.
# Leer lassen laesst die Jagd trocken laufen - Funde werden erkannt, in
# alert_event geschrieben und protokolliert, aber nicht verschickt.
FLIGHTOPT_DISCORD_WEBHOOK=
# lean (Standard, ohne Browser) oder hotels (mit Playwright und Chromium).
FLIGHTOPT_VARIANT=
# Bei FLIGHTOPT_VARIANT=hotels mitsetzen. Messwerte in docs/DEPLOYMENT.md.
FLIGHTOPT_MEM_LIMIT=
FLIGHTOPT_CPUS=
# Notausschalter fuer Booking. Der hotels-Bauweg setzt ihn selbst auf 1.
FLIGHTOPT_HOTELS_BOOKING=
# Budget des langlebigen Chromium. Leer heisst 60 Seiten, 1800 s, 120 s.
FLIGHTOPT_HOTELS_BROWSER_PAGES=
FLIGHTOPT_HOTELS_BROWSER_MAX_AGE=
FLIGHTOPT_HOTELS_BROWSER_IDLE=
